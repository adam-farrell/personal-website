---
import { Image } from 'astro:assets';
import { SITE } from 'astrowind:config';
import logo from '~/assets/images/logo.jpg';
---

<span class="self-center flex items-center gap-2 ml-2 rtl:ml-0 rtl:mr-2">
  <Image src={logo} alt="" width={32} height={32} class="w-8 h-8 rounded-md" loading="eager" />
  <span class="text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white">{SITE?.name}</span>
</span>
